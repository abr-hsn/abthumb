#!/bin/sh
# Runs the quick local CI (release build + unit tests) before every push.
# Enable once per clone:   git config core.hooksPath .githooks
# Skip one push:           git push --no-verify     (or set ABT_SKIP_CI=1)
# Tag pushes (releases) and branch deletes skip it: GitHub builds those itself.
[ -n "$ABT_SKIP_CI" ] && exit 0

run=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in refs/heads/*) ;; *) continue ;; esac
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  run=1
done
[ "$run" = 0 ] && exit 0

root=$(git rev-parse --show-toplevel)
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/ci.ps1" -Quick || {
  echo "pre-push: local CI failed, push aborted (git push --no-verify to skip)" >&2
  exit 1
}
