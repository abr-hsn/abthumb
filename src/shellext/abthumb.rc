#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ABT_VERSION_MAJOR,ABT_VERSION_MINOR,ABT_VERSION_PATCH,0
 PRODUCTVERSION ABT_VERSION_MAJOR,ABT_VERSION_MINOR,ABT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "abthumb contributors"
            VALUE "FileDescription", "abthumb thumbnail and preview handler"
            VALUE "FileVersion", ABT_VERSION_STR
            VALUE "InternalName", "abthumb.dll"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "abthumb.dll"
            VALUE "ProductName", "abthumb"
            VALUE "ProductVersion", ABT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
